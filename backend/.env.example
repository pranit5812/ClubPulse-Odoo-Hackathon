# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://demo_user:demo_password@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=clubpulse

# Security & Authentication
JWT_SECRET=super_secret_clubpulse_hackathon_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://clubpulse.vercel.app

# Environment: development / production / testing
ENVIRONMENT=development
